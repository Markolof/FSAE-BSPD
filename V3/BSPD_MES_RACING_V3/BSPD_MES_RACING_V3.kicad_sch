	(text "When the RELAY signal is LOW → the transistor turns ON → the relay coil gets current → \nthe contact closes (SDC is intact)\nWhen the RELAY signal is HIGH → the transistor turns OFF → the relay de-energizes → the contact opens → \nSDC is interrupted (FAULT condition)"
		(exclude_from_sim no)
		(at 245.491 139.573 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "29f92aa2-ceb8-4abf-a7c5-9e39e939fe76")
	)
