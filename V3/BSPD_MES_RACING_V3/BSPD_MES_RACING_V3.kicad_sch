	)
	(text "I multiplied by 1.1 because the 555 timer's \noutput stays HIGH until the capacitor charges \nto 2/3 of VCC. Using the RC charging equation, \nthe time to reach that threshold is: \nt = RC × ln(3) ≈ RC × 1.1"
		(exclude_from_sim no)
		(at 174.625 123.19 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "53d98425-c032-4430-af6e-d73667de58a9")
	)
